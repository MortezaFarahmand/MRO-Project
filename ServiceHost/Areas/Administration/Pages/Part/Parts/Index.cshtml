@page
@model ServiceHost.Areas.Administration.Pages.Part.Parts.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Parts Management";
}

<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">
                Create New Part
            </a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Parts</h3>
            </div>
            <div class="panel-body">
                <form method="get" class="form-inline">
                    <input class="form-control" asp-for="SearchModel.PartNumber" placeholder="Part Number" />
                    <input class="form-control" asp-for="SearchModel.Description" placeholder="Description" />
                    <input class="form-control" asp-for="SearchModel.Keyword" placeholder="Keyword" />
                    <button type="submit" class="btn btn-success m-l-10">Search</button>
                    <a class="btn btn-primary m-l-10" asp-page="./Index">View All</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Parts List (@Model.Parts.Count)</h3>
            </div>
            <div class="panel-body">
                <table id="datatable" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Part Number</th>
                            <th>Description</th>
                            <th>Control Type</th>
                            <th>Global</th>
                            <th>Organization</th>
                            <th>Operation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Parts)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.PartNumber</td>
                                <td>@item.Description</td>
                                <td>@item.ControlType</td>
                                <td class="text-center">
                                    @if (item.IsGlobal)
                                    {
                                        <i class="fa fa-check text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-remove text-danger"></i>
                                    }
                                </td>
                                <td>@item.OwnerOrganizationId</td>
                                <td>
                                    <a class="btn btn-warning btn-xs"
                                       href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                        <i class="fa fa-edit"></i> Edit
                                    </a>
                                    @if (!item.IsGlobal)
                                    {
                                        <a class="btn btn-info btn-xs"
                                           asp-page="./Index"
                                           asp-page-handler="MakeGlobal"
                                           asp-route-id="@item.Id">
                                            Make Global
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>
    <script>
        $(function () {
            $('#datatable').dataTable();
        });
    </script>
}