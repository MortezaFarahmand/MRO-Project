@model PartManagement.Application.Contracts.Part.Commands.EditPartCommand

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">X</button>
    <h4 class="modal-title">Edit Part</h4>
</div>

<form asp-page="./Index" asp-page-handler="Edit"
      method="post" data-ajax="true" data-action="Refresh">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Description">Description</label>
                    <input class="form-control" asp-for="Description" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Keyword">Keyword</label>
                    <input class="form-control" asp-for="Keyword" />
                </div>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Specification">Specification</label>
            <input class="form-control" asp-for="Specification" />
        </div>

        <div class="form-group">
            <label asp-for="Note">Note</label>
            <textarea class="form-control" asp-for="Note"></textarea>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info">Save</button>
    </div>
</form>