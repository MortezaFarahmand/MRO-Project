@model PartManagement.Application.Contracts.Basic_data.EquipmentType.CreateEquipmentType
@{
}


<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">X</button>
    <h4 class="modal-title">New Equipment Type</h4>
</div>

<form asp-page="./Index" asp-page-handler="Create"
      method="post"
      data-ajax="true"
      data-callback=""
      data-action="Refresh"
      enctype="multipart/form-data">
    <div class="modal-body">

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Name" class="control-label">Type</label>
                    <input type="text" class="form-control" asp-for="Name" />
                    <span asp-validation-for="Name" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Code" class="control-label">Abbraviation(2-digit) Code</label>
                    <input type="text" class="form-control" asp-for="Code"/>
                    <span asp-validation-for="Code" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="ColorCode" class="control-label">Color-Code #</label>
                    <input type="text" class="form-control" asp-for="ColorCode" />
                    <span asp-validation-for="ColorCode" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Description" class="control-label">Description</label>
                        <input type="text" class="form-control" asp-for="Description" />
                        <span asp-validation-for="Description" class="error"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Picture" class="control-label">Picture</label>
                        <input type="text" class="form-control" asp-for="Picture" />
                        <span asp-validation-for="Picture" class="error"></span>
                    </div>
                </div>
            </div>
        </div>
       
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info waves-effect waves-light">Create</button>
    </div>
</form>