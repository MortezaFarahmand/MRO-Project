<div class="row" id="EquipmentTypeDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"> Equipment type list</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Type</th>
                                    <th>Code</th>
                                    <th>Color Code</th>
                                    <th>Creation Date</th>
                                    <th>Activation</th>
                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.EquipmentTypes)
                                {
                                <tr>
                                    
                                        <td>@item.Id</td>
                                        <td>@item.Name</td>
                                        <td>@item.Code</td>
                                        <td>@item.ColorCode</td>
                                        <td>@item.CreationDate</td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <i class="fa fa-check fa-3x text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-remove fa-3x text-danger"></i>
                                            }
                                        </td>
                                    <td>
                                        <a class="btn btn-warning pull-left m-rl-5"
                                           href="#showmodal=@Url.Page("./Index", "Edit", new {id = item.Id})">
                                            <i class="fa fa-edit"></i> Edit
                                        </a>

                                            @if (item.IsActive)
                                            {
                                                <a asp-page="./Index" asp-page-handler="Deactive" asp-route-id="@item.Id"
                                                   class="btn btn-danger waves-effect waves-light w-xs m-b-5">Disable</a>
                                            }
                                            else
                                            {
                                                <a asp-page="./Index" asp-page-handler="Active" asp-route-id="@item.Id"
                                                   class="btn btn-success waves-effect waves-light w-xs m-b-5">Activate</a>
                                            }
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}
