@page
@using PartManagement.Domain.InventoryAgg.InventoryItemAgg.Enum
@model ServiceHost.Areas.Administration.Pages.Part.Inventory.InventoryItems.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Inventory Management";
}

<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "CreateSerialized")">New Serialized</a>
            <a class="btn btn-info btn-lg" href="#showmodal=@Url.Page("./Index", "CreateBatch")">New Batch</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">Search</h3></div>
            <div class="panel-body">
                <form method="get" class="form-inline">
                    <input class="form-control" asp-for="SearchModel.SerialNumber" placeholder="Serial" />
                    <input class="form-control" asp-for="SearchModel.BatchNumber" placeholder="Batch" />
                    <select class="form-control" asp-for="SearchModel.Status">
                        <option value="">- Status -</option>
                        @foreach (var s in Enum.GetValues(typeof(InventoryStatus)))
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-success m-l-10">Search</button>
                    <a class="btn btn-primary m-l-10" asp-page="./Index">View All</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Inventory List (@Model.InventoryItems.Count)</h3>
            </div>
            <div class="panel-body">
                <table id="datatable" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Part</th>
                            <th>Serial / Batch</th>
                            <th>Qty</th>
                            <th>Status</th>
                            <th>Store</th>
                            <th>Expire</th>
                            <th>Operation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.InventoryItems)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.PartNumber</td>
                                <td>@(item.SerialNumber ?? item.BatchNumber)</td>
                                <td>@item.Quantity</td>
                                <td>@item.Status</td>
                                <td>@item.StoreId</td>
                                <td>@(item.ExpireDate?.ToShortDateString() ?? "-")</td>
                                <td>
                                    @if (item.Status == "InStock")
                                    {
                                        <a class="btn btn-warning btn-xs"
                                           asp-page="./Index" asp-page-handler="Allocate" asp-route-id="@item.Id">
                                            Allocate
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>
    <script>
        $(function () { $('#datatable').dataTable(); });
    </script>
}