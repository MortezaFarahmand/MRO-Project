@model PartManagement.Application.Contracts.Inventory.InventoryItem.Commands.CreateSerializedInventoryCommand

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">X</button>
    <h4 class="modal-title">New Serialized Item</h4>
</div>

<form asp-page="./Index" asp-page-handler="CreateSerialized"
      method="post" data-ajax="true" data-action="Refresh">
    <div class="modal-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="PartId">Part</label>
                    <select class="form-control select2" asp-for="PartId" asp-items="Model.Parts">
                        <option value="">-- Select Part --</option>
                    </select>
                    <span asp-validation-for="PartId" class="error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="SerialNumber">Serial Number</label>
                    <input class="form-control" asp-for="SerialNumber" />
                    <span asp-validation-for="SerialNumber" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="StoreId">Store</label>
                    <select class="form-control select2" asp-for="StoreId" asp-items="Model.Stores">
                        <option value="">-- Select Store --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="ExpireDate">Expire Date</label>
                    <input class="form-control persianDateInput" asp-for="ExpireDate" />
                </div>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Note">Note</label>
            <textarea class="form-control" asp-for="Note"></textarea>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info">Create</button>
    </div>
</form>
