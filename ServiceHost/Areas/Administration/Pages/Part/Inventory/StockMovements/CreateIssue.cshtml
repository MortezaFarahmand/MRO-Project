@model PartManagement.Application.Contracts.Inventory.StockMovement.Commands.CreateIssueCommand

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">X</button>
    <h4 class="modal-title">Stock Issue</h4>
</div>

<form asp-page="./Index" asp-page-handler="CreateIssue"
      method="post" data-ajax="true" data-action="Refresh">
    <div class="modal-body">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="MovementNumber">Movement Number</label>
                    <input class="form-control" asp-for="MovementNumber" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="PartId">Part</label>
                    <select class="form-control select2" asp-for="PartId" asp-items="Model.Parts">
                        <option value="">-- Select Part --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="FromStoreId">From Store</label>
                    <select class="form-control select2" asp-for="FromStoreId" asp-items="Model.Stores">
                        <option value="">-- Select Store --</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Quantity">Quantity</label>
                    <input class="form-control" asp-for="Quantity" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="SerialNumber">Serial</label>
                    <input class="form-control" asp-for="SerialNumber" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="BatchNumber">Batch</label>
                    <input class="form-control" asp-for="BatchNumber" />
                </div>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Note">Note</label>
            <textarea class="form-control" asp-for="Note"></textarea>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-warning">Save Issue</button>
    </div>
</form>