@using System.Text.Json
@using PartManagement.Application.Contracts.Stock.DTOs
@using PartManagement.Application.Contracts.Stock.StockType
@model PartManagement.Application.Contracts.Stock.Store.CreateStore
@{
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">X</button>
    <h4 class="modal-title">New Store</h4>
</div>

<form asp-page="./Index" asp-page-handler="Create"
      method="post"
      data-ajax="true"
      data-callback=""
      data-action="Refresh"
      enctype="multipart/form-data">

    <div class="modal-body">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Name" class="control-label">Name</label>
                    <input type="text" class="form-control" asp-for="Name">
                    <span asp-validation-for="Name" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group element-dir-Fa">
                    <label asp-for="NameFa" class="control-label">نام</label>
                    <input type="text" class="form-control" asp-for="NameFa">
                    <span asp-validation-for="NameFa" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Code" class="control-label">Abbreviation Code (4-digit)</label>
                    <input type="text" class="form-control" asp-for="Code">
                    <span asp-validation-for="Code" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label asp-for="Description" class="control-label">Description</label>
                    <textarea class="form-control autogrow" asp-for="Description"
                              style="overflow: hidden; word-wrap: break-word; resize: horizontal; height: 75px;"></textarea>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @if (Model.IsAdmin)
                {
                    <div class="form-group">
                        <label asp-for="OrganizationId">Organization(Owner of Store)</label>
                        <select asp-for="OrganizationId"
                                asp-items="@(new SelectList(Model.Organizations ?? new(), "Id", "NameEn"))"
                                id="organizationSelect"
                                class="tom-select"
                                data-no-search="true"
                                data-dir="ltr">
                            <option value="">- Select organization -</option>
                        </select>
                        <span asp-validation-for="OrganizationId" class="error"></span>
                    </div>
                }
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="StockTypeId" class="control-label">Default Store Type</label>
                    <select asp-for="StockTypeId"
                            asp-items="@(new SelectList(Model.StockTypes ?? new(), "Id", "Name"))"
                            class="tom-select"
                            data-no-search="true">
                        <option value="">- Select default type of store -</option>
                    </select>
                    <span asp-validation-for="StockTypeId" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="ColorCode" class="control-label">Color Code</label>
                    <input type="text" class="form-control" asp-for="ColorCode">
                    <span asp-validation-for="ColorCode" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="DefaultValueOfStockMovement" class="control-label">Default value of stock Movement</label>
                    <input type="text" class="form-control" asp-for="DefaultValueOfStockMovement">
                    <span asp-validation-for="DefaultValueOfStockMovement" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="CityId" class="control-label">City</label>
                    <select asp-for="CityId"
                            asp-items="@(new SelectList(Model.Cities ?? new List<CitySimpleDto>(), "Id", "Display"))"
                            id="citySelect"
                            class="tom-select">
                        <option value="0">- Select City -</option>
                    </select>
                    <span asp-validation-for="CityId" class="error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="StationId" class="control-label">Airport station</label>
                    <select asp-for="StationId"
                            id="stationSelect"
                            class="tom-select-ajax"
                            data-url="/Administration/Lookups?handler=Stations"
                            data-min-length="1"
                            placeholder="- Select airport station -">
                        @if (Model.StationId > 0 && !string.IsNullOrEmpty(Model.StationDisplay))
                        {
                            <option value="@Model.StationId" selected>@Model.StationDisplay</option>
                        }
                        else
                        {
                            <option value="0">— Station —</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="ParentId" class="control-label">Parent of store</label>
                    <select asp-for="ParentId"
                            asp-items="@(new SelectList(Model.ParentStores ?? new(), "Id", "Display", Model.ParentId))"
                            class="tom-select"
                            data-no-search="true">
                        <option value="0">- Parent store -</option>
                    </select>
                    <span asp-validation-for="ParentId" class="error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="ProviderId" class="control-label">Provider</label>
                    <select asp-for="ProviderId"
                            asp-items="@(new SelectList(Model.Organizations ?? new(), "Id", "NameEn"))"
                            class="tom-select"
                            data-no-search="true"
                            placeholder="- Select which organization is provider for store -">
                        <option value="0">- Store provider -</option>
                    </select>
                    <span asp-validation-for="ProviderId" class="error"></span>
                </div>
            </div>
        </div>- Select airport station -

        <!-- نوع‌های انبار (چندانتخابی) -->
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label class="element-dir-Fa">انبارها(اتاق ها)ی زیر مجموعه این انبار</label>
                    <select id="stockTypeSelect"
                            name="StockTypeIds"
                            class="tom-select element-dir-Fa"
                            multiple
                            placeholder="انتخاب انواع انبارها(یا اتاقها)یی که زیر مجموعه این انبار هستند">
                        @foreach (var stockType in Model.StockTypes ?? new List<StockTypeViewModel>())
                        {
                            <option value="@stockType.Id">@stockType.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info waves-effect waves-light">Create</button>
    </div>
</form>