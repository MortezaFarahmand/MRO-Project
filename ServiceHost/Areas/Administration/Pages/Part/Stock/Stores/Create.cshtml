@using System.Text.Json
@using PartManagement.Application.Contracts.Stock.StockType
@model PartManagement.Application.Contracts.Stock.Store.CreateStore
@{
}


<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">X</button>
    <h4 class="modal-title">New Store</h4>
</div>

<form asp-page="./Index" asp-page-handler="Create"
      method="post"
      data-ajax="true"
      data-callback=""
      data-action="Refresh"
      enctype="multipart/form-data">

    <div class="modal-body">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Name" class="control-label">Name</label>
                    <input type="text" class="form-control" asp-for="Name" >
                    <span asp-validation-for="Name" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group  element-dir-Fa">
                    <label asp-for="NameFa" class="control-label">نام</label>
                    <input type="text" class="form-control" asp-for="NameFa">
                    <span asp-validation-for="NameFa" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Code" class="control-label">Abbraviation Code(4-digit)</label>
                    <input type="text" class="form-control" asp-for="Code">
                    <span asp-validation-for="Code" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label asp-for="Description" class="control-label">Description</label>
                    <textarea class="form-control autogrow" asp-for="Description" 
                              style="overflow: hidden; word-wrap: break-word; resize: horizontal; height: 75px;"></textarea>
                    <span asp-validation-for="Description" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @* <div class="form-group">
                    <label asp-for="OrganizationId" class="control-label">Organization</label>
                    <select type="text" class="form-control" asp-for="OrganizationId"
                           asp-items='new SelectList(Model.Organizations ?? new(), "Id", "NameEn")'>
                        <option value="0">-Organization-</option>
                    </select>
                    <span asp-validation-for="OrganizationId" class="error"></span>
                </div> *@
                @if (Model.IsAdmin)
                {
                    <div class="form-group">
                        <label asp-for="OrganizationId">سازمان</label>

                        <select asp-for="OrganizationId"
                                asp-items="@(new SelectList(Model.Organizations ?? new(), "Id", "NameEn"))"
                                id="organizationSelect"
                                class="form-control">
                            <option value="0">انتخاب سازمان</option>
                        </select>
                    </div>
                }
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="StockTypeId" class="control-label">Store Type</label>
                    <select type="text" class="form-control" asp-for="StockTypeId"
                            asp-items='new SelectList(Model.StockTypes ?? new(), "Id", "Name")'>
                        <option value="0">-Store type-</option>
                    </select>
                    <span asp-validation-for="StockTypeId" class="error"></span>
                </div>
            </div>
        </div>  

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="ColorCode" class="control-label">Color Code</label>
                    <input type="text" class="form-control" asp-for="ColorCode">
                    <span asp-validation-for="ColorCode" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="DefaultValueOfStockMovement" class="control-label">Default value of stock Movement</label>
                    <input type="text" class="form-control" asp-for="DefaultValueOfStockMovement">
                    <span asp-validation-for="DefaultValueOfStockMovement" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="CityId" class="control-label">City</label>
                    <select type="text" class="form-control" asp-for="CityId"
                            asp-items='new SelectList(Model.StockTypes ?? new(), "Id", "Name")'>
                        <option value="0">-City-</option>
                    </select>
                    <span asp-validation-for="CityId" class="error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="StationId" class="control-label">Airport station</label>
                    <select type="text" class="form-control" asp-for="StationId"
                            asp-items='new SelectList(Model.StockTypes ?? new(), "Id", "Name")'>
                        <option value="0">-Airport station's-</option>
                    </select>
                    <span asp-validation-for="StationId" class="error"></span>
                </div>
            </div>
            
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="ParentId" class="control-label">Parent of store</label>
                    <select type="text" class="form-control" asp-for="ParentId"
                            asp-items='new SelectList(Model.StockTypes ?? new(), "Id", "Name")'>
                        <option value="0">-Store's-</option>
                    </select>
                    <span asp-validation-for="ParentId" class="error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="ProviderId" class="control-label">Provider</label>
                    <select type="text" class="form-control" asp-for="ProviderId"
                            asp-items='new SelectList(Model.Organizations ?? new(), "Id", "NameEn")'>
                        <option value="0">-Provider's-</option>
                    </select>
                    <span asp-validation-for="ProviderId" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="stockTypeSelect">نوع‌های انبار</label>

                    <select id="stockTypeSelect"
                            class="form-control"
                            multiple
                            size="6">
                    @foreach (var stockType in Model.StockTypes ?? new List<StockTypeViewModel>())
                        {
                            <option value="@stockType.Id">@stockType.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <div id="selectedStockTypes" class="selected-stock-types"></div>
                </div>
            </div>
        </div>

        <div id="stockTypeIdInputs">
            @foreach (var id in Model.StockTypeIds ?? new List<long>())
            {
                <input type="hidden" name="StockTypeIds" value="@id" />
            }
        </div>

@*         <div id="selectedStockTypes" class="selected-stock-types"></div>
 *@
    </div>
 

    <div class="modal-footer">
        <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info waves-effect waves-light">Create</button>
    </div>
</form>

<style>
    .selected-stock-types {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        min-height: 48px;
        padding: 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        margin-top: 8px;
    }

    .stock-type-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 10px;
        color: #fff;
        background: #2878d0;
        border-radius: 3px;
    }

        .stock-type-tag button {
            border: 0;
            color: #fff;
            background: transparent;
            cursor: pointer;
            font-size: 16px;
            line-height: 1;
            padding: 0;
        }
</style>

<script>
    (() => {
        const select = document.getElementById("stockTypeSelect");
        const tagsContainer = document.getElementById("selectedStockTypes");
        const inputsContainer = document.getElementById("stockTypeIdInputs");
        const organizationSelect = document.getElementById("organizationSelect");

        // کلیدها، شناسه‌ی StockType هستند و مقدارها، نام نمایشی آن.
        const selected = new Map();

        function renderTags() {
            tagsContainer.innerHTML = "";
            inputsContainer.innerHTML = "";

            for (const [id, name] of selected) {
                const tag = document.createElement("span");
                tag.className = "stock-type-tag";
                tag.append(document.createTextNode(name));

                const removeButton = document.createElement("button");
                removeButton.type = "button";
                removeButton.textContent = "×";
                removeButton.setAttribute("aria-label", `حذف ${name}`);
                removeButton.addEventListener("click", () => {
                    selected.delete(id);
                    renderTags();
                });

                tag.appendChild(removeButton);
                tagsContainer.appendChild(tag);

                const hiddenInput = document.createElement("input");
                hiddenInput.type = "hidden";
                hiddenInput.name = "StockTypeIds";
                hiddenInput.value = id;
                inputsContainer.appendChild(hiddenInput);
            }
        }

        select.addEventListener("change", () => {
            const option = select.options[select.selectedIndex];

            if (option && option.value) {
                selected.set(option.value, option.text);
                renderTags();
            }

            // امکان انتخاب دوباره‌ی همان مورد را هم می‌دهد.
            select.selectedIndex = -1;
        });

        if (organizationSelect) {
            organizationSelect.addEventListener("change", async () => {
                selected.clear();
                renderTags();
                select.innerHTML = "";

                if (!organizationSelect.value) {
                    return;
                }

                const url = new URL(window.location.href);
                url.searchParams.set("handler", "StockTypes");
                url.searchParams.set("organizationId", organizationSelect.value);

                const response = await fetch(url);

                if (!response.ok) {
                    alert("دریافت نوع‌های موجودی با خطا روبه‌رو شد.");
                    return;
                }

                const stockTypes = await response.json();

                for (const item of stockTypes) {
                    const option = document.createElement("option");
                    option.value = item.id;
                    option.textContent = item.name;
                    select.appendChild(option);
                }
            });
        }

        renderTags();
    })();
</script>

