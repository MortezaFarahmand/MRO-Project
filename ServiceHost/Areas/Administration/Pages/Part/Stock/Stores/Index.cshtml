@page
@using PartManagement.Configuration.Permissions
@model ServiceHost.Areas.Administration.Pages.Part.Stock.Stores.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Stores Management";
}

<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">Create New</a>
        </p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Stores</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Name"></label>
                        <input class="form-control" asp-for="SearchModel.Name" placeholder="Name">
                    </div>
                    <div class="form-group element-dir-Fa">
                        <label class="sr-only" asp-for="SearchModel.Code"></label>
                        <input class="form-control" asp-for="SearchModel.Code" placeholder="Code">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.StockTypeId"></label>
                        <select class="form-control" asp-for="SearchModel.StockTypeId" asp-items="Model.StockTypes">
                            <option value="0">-Stock Type-</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.OrganizationId"></label>
                        <select class="form-control" asp-for="SearchModel.OrganizationId"
                                asp-items="Model.Organizations" disabled="@(!Model.SearchModel.IsAdmin)">
                            <option value="0">-Organizations-</option>
                        </select>
                        @if (!Model.SearchModel.IsAdmin)
                        {
                            <input type="hidden" asp-for="SearchModel.OrganizationId" />
                        }
                    </div>
                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Store list (@(Model.Stores?.Count ?? 0))</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th>Organization</th>
                                    <th>Type</th>
                                    <th>City</th>
                                    <th>Station</th>
                                    <th>Parent Store</th>
                                    <th>Type</th>
                                    <th>Creation Date</th>
                                    <th>Activation</th>
                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Stores)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@item.Name</td>
                                        <td>@item.Code</td>
                                        <td>@item.OrganizationName</td>
                                        <td>@item.StockType</td>
                                        <td>@item.City</td>
                                        <td>@item.StationId</td>
                                        <td>@item.ParentId</td>
                                        <td>@item.StockTypeId</td>
                                        <td>@item.CreationDate</td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <i class="fa fa-check fa-3x text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-remove fa-3x text-danger"></i>
                                            }
                                        </td>
                                        <td style="white-space: nowrap;">
                                            <a class="btn btn-warning waves-effect waves-light w-xs m-b-5"
                                               href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                                <i class="fa fa-edit"></i> Edit
                                            </a>
                                            <a class="btn btn-info waves-effect waves-light w-xs m-b-5"
                                               href="#showmodal=@Url.Page("./Index", "Policies", new { id = item.Id })">
                                                <i class="fa fa-cogs"></i> Policies
                                            </a>
                                            <a class="btn btn-default waves-effect waves-light w-xs m-b-5"
                                               asp-page="/Part/Stock/StockZones/Index"
                                               asp-route-StoreId="@item.Id">
                                                Zones
                                            </a>
                                            @if (item.IsActive)
                                            {
                                                <a asp-page="./Index" asp-page-handler="Deactive" asp-route-id="@item.Id"
                                                   class="btn btn-danger waves-effect waves-light w-xs m-b-5">Disable</a>
                                            }
                                            else
                                            {
                                                <a asp-page="./Index" asp-page-handler="IsActive" asp-route-id="@item.Id"
                                                   class="btn btn-success waves-effect waves-light w-xs m-b-5">Activate</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}
