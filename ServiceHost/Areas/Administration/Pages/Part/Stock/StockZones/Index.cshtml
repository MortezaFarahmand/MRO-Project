@page
@model ServiceHost.Areas.Administration.Pages.Part.Stock.StockZones.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Store Zones Management";
}

<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg"
               href="#showmodal=@Url.Page("./Index", "Create", new { storeId = Model.StoreId })">
                Create New
            </a>
        </p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Store Zones</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <select class="form-control" asp-for="StoreId" asp-items="Model.Stores">
                            <option value="">— Store —</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <input class="form-control" asp-for="Code" placeholder="Code" />
                    </div>
                    <div class="form-group">
                        <select class="form-control" asp-for="IsActive">
                            <option value="">— Status —</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Zone list (@(Model.Zones?.Count ?? 0))</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Store</th>
                                    <th>Zone Code</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>ATA</th>
                                    <th>Keyword</th>
                                    <th>Location</th>
                                    <th>Environment</th>
                                    <th>Active</th>
                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Zones != null && Model.Zones.Any())
                                {
                                    foreach (var item in Model.Zones)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.StoreName</td>
                                            <td>@item.Code</td>
                                            <td>@item.Name</td>
                                            <td>@item.ZoneTypeTitle</td>
                                            <td>@(item.AtaChapterDisplay ?? item.AtaChapterId?.ToString())</td>
                                            <td>@item.KeywordGroup</td>
                                            <td>@item.LocationKind</td>
                                            <td>@item.EnvironmentalClass</td>
                                            <td class="text-center">
                                                @if (item.IsActive)
                                                {
                                                    <i class="fa fa-check fa-2x text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-remove fa-2x text-danger"></i>
                                                }
                                            </td>
                                            <td style="white-space: nowrap;">
                                                <a class="btn btn-warning waves-effect waves-light w-xs m-b-5"
                                                   href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                                    <i class="fa fa-edit"></i> Edit
                                                </a>
                                                @if (item.IsActive)
                                                {
                                                    <a class="btn btn-danger waves-effect waves-light w-xs m-b-5"
                                                       asp-page="./Index"
                                                       asp-page-handler="Deactivate"
                                                       asp-route-id="@item.Id"
                                                       asp-route-StoreId="@Model.StoreId">
                                                        Disable
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-success waves-effect waves-light w-xs m-b-5"
                                                       asp-page="./Index"
                                                       asp-page-handler="Activate"
                                                       asp-route-id="@item.Id"
                                                       asp-route-StoreId="@Model.StoreId">
                                                        Activate
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="11" class="text-center">No zones found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>
    <script type="text/javascript">
        // $(document).ready(function () {
        //     $('#datatable').dataTable();
        // });
        $(document).ready(function () {
    if ($('#datatable tbody tr td').length > 1) {
        $('#datatable').dataTable();
            }
        });
    </script>
}