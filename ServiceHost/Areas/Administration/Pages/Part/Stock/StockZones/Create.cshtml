@model PartManagement.Application.Contracts.Stock.Commands.CreateStoreZoneCommand
@{
    
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
    <h4 class="modal-title">New Store Zone</h4>
</div>

<form asp-page="./Index" asp-page-handler="Create"
      method="post"
      data-ajax="true"
      data-callback=""
      data-action="Refresh">

    <div class="modal-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="StoreId">Store</label>
                    <select asp-for="StoreId" class="form-control" asp-items="Model.Stores">
                        <option value="0">— Select Store —</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="Code">Code</label>
                    <input asp-for="Code" class="form-control" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="ZoneType">Zone Type</label>
                    <select asp-for="ZoneType" class="form-control" asp-items="Model.ZoneTypes">
                        <option value="">- Zone Type -</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="AtaChapterId">ATA Chapter</label>
                    <select asp-for="AtaChapterId" class="form-control" asp-items="Model.AtaChapters">
                        <option value="0">— Select ATA Chapter —</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="KeywordGroup">Keyword Group</label>
                    <input asp-for="KeywordGroup" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="AircraftModelId">Aircraft Model</label>
                    <select asp-for="AircraftModelId" class="form-control" asp-items="Model.AircraftModels">
                        <option value="0">— Select A/C Model —</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="LocationKind">Location Kind</label>
                    <select asp-for="LocationKind" class="form-control" asp-items="Model.LocationKinds">
                        <option value="">— Select Location Kind -</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="EnvironmentalClass">Environmental Class</label>
                    <select asp-for="EnvironmentalClass" class="form-control" asp-items="Model.EnvironmentalClasses">
                        <option value="">— Select Environment Class -</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="MaxWeightKg">Max Weight (Kg)</label>
                    <input asp-for="MaxWeightKg" type="number" step="0.01" class="form-control" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="MaxVolumeM3">Max Volume (m³)</label>
                    <input asp-for="MaxVolumeM3" type="number" step="0.001" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info waves-effect waves-light">Create</button>
    </div>
</form>
