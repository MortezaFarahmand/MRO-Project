@model PersonnelManagement.Application.Contracts.PersonGroup.EditPersonGroup
@{
}


<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">X</button>
    <h4 class="modal-title">Edit Person-Group: @Model.Description</h4>
</div>

<form asp-page="./Index" asp-page-handler="Edit"
      method="post"
      data-ajax="true"
      data-callback=""
      data-action="Refresh"
      enctype="multipart/form-data">
    <div class="modal-body">

        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label asp-for="Description" class="control-label">Description</label>
                    <input type="text" class="form-control" asp-for="Description" />
                    <span asp-validation-for="Description" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row"> 
            <div class="col-md-12">
                 <div class="form-group">
                    <label asp-for="Remark" class="control-label">Remark</label>
                    <input type="text" class="Remark" asp-for="Remark" />
                    <span asp-validation-for="Remark" class="error"></span>
                 </div>
            </div>        
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label asp-for="IsActive" class="control-label">Activate</label>
                    <input type="text" class="form-control" asp-for="IsActive"/>
                    <span asp-validation-for="IsActive" class="error"></span>
                </div>
            </div>
        </div>

        <input type="hidden" asp-for="Id" value="@Model.Id" />

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info waves-effect waves-light">Edit</button>
    </div>
</form>