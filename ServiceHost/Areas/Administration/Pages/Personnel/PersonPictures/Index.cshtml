@page
@model ServiceHost.Areas.Administration.Pages.Personnel.PersonPictures.IndexModel



@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Person Pictures Management";
}



<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">Create New</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Person Pictures</h3>
            </div>
            <div class="panel-body ">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only " asp-for="SearchModel.Title"></label>
                        <input class="form-control " asp-for="SearchModel.Title" placeholder="Title">
                    </div>

                    <div class="form-group">
                        <label class="sr-only col-sm-6" asp-for="SearchModel.PersonId"></label>
                        <select class="select2" asp-for="SearchModel.PersonId"
                                asp-items="Model.Persons">
                            <option value="0">-Persons-</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <span asp-validation-for="SearchModel.PictureCategoryId" class="error"></span>
                        <label class="sr-only" asp-for="SearchModel.PictureCategoryId"></label>
                        <select class="form-control" asp-for="SearchModel.PictureCategoryId"
                                asp-items="Model.PictureCategories">
                            <option value="0">-Picture Categories-</option>
                        </select>
                    </div> 

                 

                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>

                </form>
            </div>
        </div>
    </div>
</div>



<div class="row" id="PersonPictureDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Person Pictures list</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Picture</th>
                                    <th>Person</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Activation</th>
                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PersonPictures)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>
                                            <img src="~/Img/@item.Picture" style="width: 70px; height: 70px"/>
                                        </td>
                                        <td>@item.Person</td>
                                        <td>@item.Title</td>
                                        <td>@item.PictureCategory</td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <i class="fa fa-check fa-3x text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-remove fa-3x text-danger"></i>
                                            }
                                        </td>
                                         @* <td>@item.CreationDate</td> *@
                                        <td>
                                            <a class="btn btn-warning waves-effect waves-light w-xs m-b-5 "
                                               href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                                <i class="fa fa-edit"></i> Edit
                                            </a>
                                            @if (item.IsActive)
                                            {
                                                <a asp-page="./Index" asp-page-handler="Remove" asp-route-id="@item.Id"
                                                   class="btn btn-danger waves-effect waves-light w-xs m-b-5">Deactive</a>
                                            }
                                            else
                                            {
                                                <a asp-page="./Index" asp-page-handler="Restore" asp-route-id="@item.Id"
                                                   class="btn btn-success waves-effect waves-light w-xs m-b-5">Active</a>
                                            }

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>
    <script src="~/AdminTheme/assets/js/select2.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });

        $('.select22').select2({
                width: '100%'
        });

    </script>

   
}

