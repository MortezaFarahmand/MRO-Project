@model PersonnelManagement.Application.Contracts.PersonPicture.EditPersonPicture
@{
}


<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">X</button>
    <h4 class="modal-title">Edit "@Model.Title" Person </h4>
</div>

<form asp-page="./Index" asp-page-handler="Edit"
      method="post"
      data-ajax="true"
      data-callback=""
      data-action="Refresh"
      enctype="multipart/form-data">

    <div class="modal-body">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label asp-for="Picture" class="control-label">Picture *</label>
                    <input type="file" class="form-control" asp-for="Picture" >
                    <span asp-validation-for="Picture" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Title" class="control-label">Title</label>
                    <input type="text" class="form-control" asp-for="Title">
                    <span asp-validation-for="Title" class="error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group  element-dir-Fa">
                    <label asp-for="Text" class="control-label">Text</label>
                    <input type="text" class="form-control" asp-for="Text">
                    <span asp-validation-for="Text" class="error"></span>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="PictureCategoryId" class="control-label">Picture Category</label>
                    <select type="text" class="form-control" asp-for="PictureCategoryId"
                            asp-items='new SelectList(Model.PictureCategories, "Id", "Name")'>
                        <option value="0">-Picture Categories-</option>
                    </select>
                    <span asp-validation-for="PictureCategoryId" class="error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="control-label" asp-for="PersonId">Person Lists</label>
                    <select class="select22" asp-for="PersonId"
                            asp-items='new SelectList(Model.Persons, "Id", "Name")'>
                        <option value="0">-Persons-</option>
                    </select>
                    <span asp-validation-for="PersonId" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group  element-dir-Fa">
                    <label asp-for="Remark" class="control-label">Remark</label>
                    <input type="text" class="form-control" asp-for="Remark">
                    <span asp-validation-for="Remark" class="error"></span>
                </div>
            </div>
        </div>



        <input type="hidden" asp-for="Id" value="@Model.Id" />
    </div>
    



    <div class="modal-footer">
        <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info waves-effect waves-light">Edit</button>
    </div>
</form>