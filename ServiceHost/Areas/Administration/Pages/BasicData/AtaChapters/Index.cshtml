@page
@model ServiceHost.Areas.Administration.Pages.BasicData.AtaChapters.IndexModel
@{
    ViewData["Title"] = "ATA Chapters";
}

<h2>فصل‌های ATA</h2>

<p><a asp-page="./Create" class="btn btn-primary">افزودن فصل</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>کد</th><th>عنوان (EN)</th><th>عنوان (FA)</th>
            <th>گروه</th><th>ترتیب</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Chapters)
    {
        <tr>
            <td>@c.Code</td>
            <td>@c.TitleEn</td>
            <td>@c.TitleFa</td>
            <td>@c.Group</td>
            <td>@c.DisplayOrder</td>
            <td>
                <a asp-page="./Tree" asp-route-code="@c.Code">درخت</a> |
                <a asp-page="./Edit" asp-route-id="@c.Id">ویرایش</a>
            </td>
        </tr>
    }
    </tbody>
</table>