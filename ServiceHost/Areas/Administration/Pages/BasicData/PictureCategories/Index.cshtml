@page
@model ServiceHost.Areas.Administration.Pages.BasicData.PictureCategories.IndexModel

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Picture Category Management";
}



<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">Create New</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Picture Category</h3>
            </div>
            <div class="panel-body ">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">

                        <label class="sr-only" asp-for="SearchModel.EntitiId"></label>
                        <select class="form-control " asp-for="SearchModel.EntitiId" asp-items="Model.Entitis">
                            <option value="0">-Entity-</option>
                        </select>

                        <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                        <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>

                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="PictureCategorysDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">PictureCategory list</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    @* <th>Image</th> *@
                                    <th>Name</th>
                                    <th>Entity Id</th>
                                    <th>Remark</th>
                                    <th>Activate</th>
                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PictureCategorys)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        @* <td>
                                      <img src="@item.Picture" style="width: 70px; height: 70px" />
                                    </td> *@
                                        <td>@item.Name</td>
                                        <td>@item.Entiti</td>
                                        <td style="font-family:IranianSans">@item.Remark</td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <i class="fa fa-check fa-3x text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-remove fa-3x text-danger"></i>
                                            }
                                        </td>
                                        <td>
                                            <a class="btn btn-warning waves-effect waves-light w-xs m-b-5 "
                                               href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                                <i class="fa fa-edit"></i> Edit
                                            </a>
                                            @if (item.IsActive)
                                            {
                                                <a asp-page="./Index" asp-page-handler="DeActive" asp-route-id="@item.Id"
                                                   class="btn btn-danger waves-effect waves-light w-xs m-b-5">DeActive</a>
                                            }
                                            else
                                            {
                                                <a asp-page="./Index" asp-page-handler="Active" asp-route-id="@item.Id"
                                                   class="btn btn-success waves-effect waves-light w-xs m-b-5">Active</a>
                                            }

                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}
