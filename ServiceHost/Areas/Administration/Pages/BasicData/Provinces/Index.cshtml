@page
@model ServiceHost.Areas.Administration.Pages.BasicData.Provinces.IndexModel

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Provinces Management";
}



<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">Create New</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Provinces</h3>
            </div>
            <div class="panel-body ">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only " asp-for="SearchModel.Name"></label>
                        <input class="form-control " asp-for="SearchModel.Name" placeholder="Name">
                    </div>
                    <div class="form-group">
                        <label class="sr-only " asp-for="SearchModel.DialCode"></label>
                        <input class="form-control " asp-for="SearchModel.DialCode" placeholder="نام">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.CountryId"></label>
                        <select class="form-control " asp-for="SearchModel.CountryId" asp-items="Model.Countrys">
                            <option value="0">-Country-</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>

                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="ProvinceDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Province list</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Dial Code</th>
                                    <th>Country</th>
                                    <th>Meta Description</th>
                                    <th>Slug</th>
                                    <th>Keywords</th>
                                    <th>Operation</th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Provinces)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@item.Name</td>
                                        <td>@item.DialCode</td>
                                        <td>@item.Country</td>
                                        <td>@item.MetaDescription</td>
                                        <td>@item.Slug</td>
                                        <td>@item.Keywords</td>
                                        <td>
                                            <a class="btn btn-warning waves-effect waves-light w-xs m-b-5 "
                                               href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                                <i class="fa fa-edit"></i> Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}

