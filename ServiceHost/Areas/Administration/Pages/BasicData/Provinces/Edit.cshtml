@model BasicDataManagement.Application.Contracts.Province.EditProvince
@{
}


<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">X</button>
    <h4 class="modal-title" style="font-family:IranianSans">Edit "@Model.Name" Province </h4>
</div>

<form asp-page="./Index" asp-page-handler="Edit"
      method="post"
      data-ajax="true"
      data-callback=""
      data-action="Refresh"
      enctype="multipart/form-data">

    <div class="modal-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Name" class="control-label" style="font-family:IranianSans">استان نام</label>
                    <input type="text" class="form-control" asp-for="Name" style="font-family:IranianSans" onchange="makeSlug('NameEn','Slug')">
                    <span asp-validation-for="Name" class="error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group  element-dir-Fa">
                    <label asp-for="DialCode" class="control-label" style="font-family:IranianSans">پیش شماره</label>
                    <input type="text" class="form-control" asp-for="DialCode">
                    <span asp-validation-for="DialCode" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label asp-for="MetaDescription" class="control-label">Meta Description</label>
                    <textarea class="form-control autogrow" asp-for="MetaDescription"
                              style="overflow: hidden; word-wrap: break-word; resize: horizontal; height: 75px;"></textarea>
                    <span asp-validation-for="MetaDescription" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="form-group  element-dir-Fa">
                    <label asp-for="Keywords" class="control-label" >Keywords</label>
                    <textarea class="form-control autogrow" asp-for="Keywords"
                              style="overflow: hidden; word-wrap: break-word; resize: horizontal; height: 75px;"></textarea>
                    <span asp-validation-for="Keywords" class="error"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="CountryId" class="control-label">Country</label>
                    <select type="text" class="form-control" asp-for="CountryId"
                            asp-items='new SelectList(Model.Countries, "Id", "Name")'>
                        <option value="0">-Country-</option>
                    </select>
                    <span asp-validation-for="CountryId" class="error"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Slug" class="control-label">Slug</label>
                    <input type="text" class="form-control" asp-for="Slug">
                    <span asp-validation-for="Slug" class="error"></span>
                </div>
            </div>
        </div>

    </div>


    <div class="modal-footer">
        <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info waves-effect waves-light">Edit</button>
    </div>
</form>