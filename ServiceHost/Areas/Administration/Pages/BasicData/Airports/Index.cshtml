@page
@model ServiceHost.Areas.Administration.Pages.BasicData.Airports.IndexModel
@{
}

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Airports Management";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
        <p class="pull-left">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">Create New Airport</a>
        </p>
    </div>
</div>



<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Airports</h3>
            </div>
            <div class="panel-body ">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">

                        <label class="sr-only " asp-for="SearchModel.Name"></label>
                        <input class="form-control " asp-for="SearchModel.Name" placeholder="Name">

                        <label class="sr-only" asp-for="SearchModel.Type"></label>
                        <input class="form-control " asp-for="SearchModel.Type" placeholder="Type of Airport">

                        @* <label class="sr-only" asp-for="SearchModel.Elevation_ft"></label>
                        <input class="form-control " asp-for="SearchModel.Elevation_ft" placeholder="Elevation(ft)">
 *@
                        <label class="sr-only" asp-for="SearchModel.Continent"></label>
                        <input class="form-control " asp-for="SearchModel.Continent" placeholder="Continent">

                        <label class="sr-only" asp-for="SearchModel.Iso_country"></label>
                        <input class="form-control " asp-for="SearchModel.Iso_country" placeholder="ISO Country">


                        <label class="sr-only" asp-for="SearchModel.Icao_code"></label>
                        <input class="form-control " asp-for="SearchModel.Icao_code" placeholder="ICAO Code">


                        <label class="sr-only" asp-for="SearchModel.Iata_code"></label>
                        <input class="form-control " asp-for="SearchModel.Iata_code" placeholder="IATA Code">


                        <label class="sr-only" asp-for="SearchModel.Municipality"></label>
                        <input class="form-control " asp-for="SearchModel.Municipality" placeholder="Municipality">
                        @* <label class="sr-only" asp-for="SearchModel.CountryId"></label>
                        <select class="form-control " asp-for="SearchModel.CountryId" asp-items="Model.Countrys">
                            <option value="0">Select Country ... </option>
                        </select> *@

                        <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                        <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>

                    </div>

                </form>
            </div>
        </div>
    </div>
</div>


<div class="row" id="AirportsDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Airports List</h3>
            </div> 
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Elevation(ft)</th>
                                    <th>ICAO Code</th>
                                    <th>IATA Code</th>
                                    <th>Continent</th>
                                    <th>Municipality</th>
                                    <th>ISO Country</th>
@*                                     <th>Activation</th>
 *@                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Airports)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        @* <td>
                                            <img src="~/Img/@item.Picture" style="width: 70px; height: 70px" />
                                        </td> *@
                                        <td>@item.Name</td>
                                        <td>@item.Type</td>
                                        <td>@item.Elevation_ft</td>
                                        <td>@item.Icao_code</td>
                                        <td>@item.Iata_code</td>
                                        <td>@item.Continent</td>
                                        <td>@item.Municipality</td>
                                        <td>@item.Iso_country</td>
                                        @* <td class="text-center">
                                            @if (!item.IsActive)
                                            {
                                                <i class="fa fa-check fa-3x text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-remove fa-3x text-danger"></i>
                                            }
                                        </td> *@
                                        <td>
                                            <a class="btn btn-warning waves-effect waves-light m-b-5"
                                               href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id})">
                                                <i class="fa fa-edit"></i> ویرایش
                                            </a>
                                            @* @if (!item.IsActive)
                                            {
                                                <a asp-page="./Index" asp-page-handler="Remove" asp-route-id="@item.Id"
                                                   class="btn btn-danger waves-effect waves-light m-b-5">حذف</a>
                                            }
                                            else
                                            {
                                                <a asp-page="./Index" asp-page-handler="Restore" asp-route-id="@item.Id"
                                                   class="btn btn-success waves-effect waves-light m-b-5">فعال سازی</a>
                                            } *@
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}