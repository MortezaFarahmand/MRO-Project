@page
@model ServiceHost.Areas.Administration.Pages.Organization.OrganizationPositions.IndexModel

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Organization Position Management";
}



<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")" >Create New</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Organization Positions</h3>
            </div>
            <div class="panel-body ">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        
                        <label class="sr-only " asp-for="SearchModel.Name"></label>
                        <input class="form-control " asp-for="SearchModel.Name" placeholder="Name">

                        <div class="form-group">
                            <label class="sr-only col-sm-6" asp-for="SearchModel.OrganizationId"></label>
                            <select class="select2" id="orgId" asp-for="SearchModel.OrganizationId"
                                    asp-items="Model.Organizations">
                                <option value="0">-Organizations-</option>
                            </select>
                        </div>

                        <div class="form-group" id="divDepart">
                            <label class="sr-only col-sm-6" asp-for="SearchModel.OrganizationDepartmentId"></label>
                            <select class="select2" id="orgDepartId" asp-for="SearchModel.OrganizationDepartmentId"
                                    asp-items="Model.OrganizationDepartments">
                                <option value="0">-Departments-</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="sr-only col-sm-6" asp-for="SearchModel.ParentPositionId"></label>
                            <select class="select2" id="parentPos" asp-for="SearchModel.ParentPositionId"
                                    asp-items="Model.OrganizationPositionss">
                                <option value="0">-Positions-</option>
                            </select>
                        </div>
                        

                        <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                        <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>
                          
                    </div>
                   
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="OrganizationPositionDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Organization Position list</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Organization</th>
                                    <th>Department</th>
                                    <th>Parent</th>
                                    <th>Descreption</th>
                                    <th>Creation Date</th>
                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrganizationPositions)
                                {
                                <tr>
                                        <td>@item.Id</td>
                                        <td>@item.Name</td>
                                        <td>@item.OrganizationName</td>
                                        <td>@item.OrganizationDepartment</td>
                                        <td>@item.ParentPosition</td>
                                        <td>@item.Description</td>
                                        <td>@item.CreationDate</td>
                                    <td>
                                        <a class="btn btn-warning pull-left m-rl-5"
                                           href="#showmodal=@Url.Page("./Index", "Edit", new {id = item.Id})">
                                            <i class="fa fa-edit"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* <script src="~/admintheme/assets/js/cascadingDLL.js"></script> *@



@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script>
        $("#orgId").on('change', function(e){
            if($("#orgId").prop('selectedIndex') == 0){
                $('#divDepart').addClass('hidden');
            }
            else{
                //اگر یک سازمان انتخاب شده بود
                var getId = $("#orgId").val();
                // alert(getId);
                $.ajax({
                type: 'post',
                url: '@Url.Action("GetDepartmentByOrganizationIds", "Index")',
                data: {id: getId}
                });

                $('#divDepart').removeClass('hidden');
            }
        });
    </script> 

