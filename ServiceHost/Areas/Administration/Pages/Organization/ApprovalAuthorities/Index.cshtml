@page
@model ServiceHost.Areas.Administration.Pages.Organization.ApprovalAuthorities.IndexModel

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Approval Authority Management";
}



<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")" >Create New</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Approval Authority(Type)</h3>
            </div>
            <div class="panel-body ">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        
                                <label class="sr-only " asp-for="SearchModel.NameEn"></label>
                                <input class="form-control " asp-for="SearchModel.NameEn" placeholder="NameEn">
                            
                                <label class="sr-only" asp-for="SearchModel.Description"></label>
                                <input class="form-control " asp-for="SearchModel.Description" placeholder="Description">

                                <label class="sr-only" asp-for="SearchModel.Code"></label>
                                <input class="form-control " asp-for="SearchModel.Code" placeholder="Code">

                               <label class="sr-only" asp-for="SearchModel.CountryId"></label>
                               <select class="form-control " asp-for="SearchModel.CountryId" asp-items="Model.Countrys">
                                <option value="0">-Country-</option>
                               </select>
                        
                                <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                                <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>
                          
                    </div>
                   
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="ApprovalAuthorityDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Approval Authority list</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    @*<th>Logo</th>*@
                                    <th>NameEn</th>
                                    <th>NameFa</th>
                                    <th>Descreption</th>
                                    <th>Code</th>
                                    <th>Country</th>
                                    <th>Remark</th>
                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ApprovalAuthorities)
                                {
                                <tr>
                                        <td>@item.Id</td>
                                        @*<td>
                                    <img src="~/ProductPictures/@item.Picture" style="width: 70px; height: 70px" />
                                    </td>*@
                                        <td>@item.NameEn</td>
                                        <td>@item.NameFa</td>
                                        <td>@item.Description</td>
                                        <td>@item.Code</td>
                                        <td>@item.Country</td>
                                        <td>@item.Remark</td>
                                    <td>
                                        <a class="btn btn-warning pull-left m-rl-5"
                                           href="#showmodal=@Url.Page("./Index", "Edit", new {id = item.Id})">
                                            <i class="fa fa-edit"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}
