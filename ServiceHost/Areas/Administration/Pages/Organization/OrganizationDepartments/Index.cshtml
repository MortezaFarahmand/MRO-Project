@page
@model ServiceHost.Areas.Administration.Pages.Organization.OrganizationDepartments.IndexModel

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Organization Department Management";
}



<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")" >Create New</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Organization Departments</h3>
            </div>
            <div class="panel-body ">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        
                        <label class="sr-only " asp-for="SearchModel.Name"></label>
                        <input class="form-control " asp-for="SearchModel.Name" placeholder="Name">

                        <div class="form-group">
                            <label class="sr-only col-sm-6" asp-for="SearchModel.OrganizationId"></label>
                            <select class="select2" asp-for="SearchModel.OrganizationId"
                                    asp-items="Model.Organizations">
                                <option value="0">-Organizations-</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="sr-only col-sm-6" asp-for="SearchModel.ParentDepartmentId"></label>
                            <select class="select2" asp-for="SearchModel.ParentDepartmentId"
                                    asp-items="Model.OrganizationDepartmentss">
                                <option value="0">-Departments-</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                        <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>
                          
                    </div>
                   
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="OrganizationDepartmentDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Organization Department list</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Organization</th>
                                    <th>Parent</th>
                                    <th>Descreption</th>
                                    <th>Creation Date</th>
                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrganizationDepartments)
                                {
                                <tr>
                                        <td>@item.Id</td>
                                        <td>@item.Name</td>
                                        <td>@item.Organization</td>
                                        <td>@item.ParentDepartment</td>
                                        <td>@item.Description</td>
                                        <td>@item.CreationDate</td>
                                    <td>
                                        <a class="btn btn-warning pull-left m-rl-5"
                                           href="#showmodal=@Url.Page("./Index", "Edit", new {id = item.Id})">
                                            <i class="fa fa-edit"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}
