@page
@model ServiceHost.Areas.Administration.Pages.Organization.OrganizationAviationCodes.IndexModel

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Organization Aviation Codes Management";
}



<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")" >Create New</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in OrganizationAviationCode</h3>
            </div>
            <div class="panel-body ">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        
                        <label class="sr-only " asp-for="SearchModel.ICAO"></label>
                        <input class="form-control " asp-for="SearchModel.ICAO" placeholder="ICAO Code">
                            
                        <label class="sr-only" asp-for="SearchModel.Description"></label>
                        <input class="form-control " asp-for="SearchModel.Description" placeholder="Description">
                           
                        @* <label class="sr-only" asp-for="SearchModel.CountryId"></label>
                        <select class="form-control " asp-for="SearchModel.CountryId" asp-items="Model.Countries" >
                            <option value="0" >Select Country ... </option>
                        </select> *@

                        <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                        <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">View All</a>
                          
                    </div>
                   
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="OrganizationAviationCodesDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Organization Aviation Code list</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>ICAO</th>
                                    <th>IATA</th>
                                    <th>Civil Authority Code</th>
                                    <th>Country</th>
                                    <th>Description</th>
                                    <th>Comment</th>
                                    <th>Call Sign</th>
                                    <th>Activation</th>
                                    @*<th>Creation Date</th>*@
                                    <th>Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.organizationAviationCodes)
                                {
                                <tr>
                                        <td>@item.Id</td>
                                       @* <td>
                                          <img src="@item.Picture" style="width: 70px; height: 70px" />
                                        </td>*@
                                        <td>@item.ICAO</td>
                                        <td>@item.IATA</td>
                                        <td>@item.CivilAutority</td>
                                        <td>@item.Country</td>
                                        <td>@item.Description</td>
                                        <td>@item.Comment</td>
                                        <td>@item.CallSign</td>
                                        <td class="text-center">
                                            @if (item.IsEnabled)
                                            {
                                                <i class="fa fa-check fa-3x text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-remove fa-3x text-danger"></i>
                                            }
                                        </td>
                                        @*<td>@item.CreationDate</td>*@
                                    <td>
                                        <a class="btn btn-warning btn-custom waves-effect waves-light m-b-5"
                                           href="#showmodal=@Url.Page("./Index", "Edit", new {id = item.Id})">
                                            <i class="fa fa-edit"></i> Edit
                                        </a>

                                            @if (item.IsEnabled == true)
                                            {
                                                <a asp-page="./Index" asp-page-handler="NotEnabled"
                                           asp-route-id="@item.Id" class="btn btn-danger btn-custom waves-effect waves-light m-b-5">Disable</a>
                                            }
                                            else
                                            {
                                                <a asp-page="./Index" asp-page-handler="Enabled"
                                           asp-route-id="@item.Id" class="btn btn-success btn-custom waves-effect waves-light m-b-5">Enable</a>
                                            }

                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}
