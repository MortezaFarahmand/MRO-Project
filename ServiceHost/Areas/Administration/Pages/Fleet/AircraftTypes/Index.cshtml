@page
@model ServiceHost.Areas.Administration.Pages.Fleet.AircraftTypes.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Aircraft Types";
}

<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">Create New</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">Search</h3></div>
            <div class="panel-body">
                <form method="get" class="form-inline">
                    <input class="form-control" asp-for="SearchModel.Code" placeholder="Code" />
                    <input class="form-control" asp-for="SearchModel.Name" placeholder="Name" />
                    <button type="submit" class="btn btn-success m-l-10">Search</button>
                    <a class="btn btn-primary m-l-10" asp-page="./Index">View All</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Aircraft Types (@Model.AircraftTypes.Count)</h3>
            </div>
            <div class="panel-body">
                <table id="datatable" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Active</th>
                            <th>Operation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AircraftTypes)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <i class="fa fa-check text-success"></i>
                                    }
                                    else
                                    {

                                        <i class="fa fa-remove text-danger"></i>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-warning btn-xs"
                                       href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                        Edit
                                    </a>
                                    @if (item.IsActive)
                                    {
                                        <a class="btn btn-danger btn-xs"
                                           asp-page="./Index" asp-page-handler="Deactivate" asp-route-id="@item.Id">
                                            Deactivate
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-success btn-xs"
                                           asp-page="./Index" asp-page-handler="Activate" asp-route-id="@item.Id">
                                            Activate
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>
    <script>$(function () { $('#datatable').dataTable(); });</script>
}