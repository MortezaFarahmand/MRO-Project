@model FleetManagement.Application.Contracts.AircraftType.Commands.CreateAircraftTypeCommand

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">X</button>
    <h4 class="modal-title">New Aircraft Type</h4>
</div>

<form asp-page="./Index" asp-page-handler="Create"
      method="post" data-ajax="true" data-action="Refresh">
    <div class="modal-body">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Code">Code</label>
                    <input class="form-control" asp-for="Code" placeholder="B737, A320, ..." />
                    <span asp-validation-for="Code" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Name">Name</label>
                    <input class="form-control" asp-for="Name" />
                    <span asp-validation-for="Name" class="error"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Description">Description</label>
                    <input class="form-control" asp-for="Description" />
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-info">Create</button>
    </div>
</form>