@page
@model ServiceHost.Areas.Administration.Pages.Fleet.Aircrafts.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Aircrafts";
}

<div class="row">
    <div class="col-sm-12">
        <h3 class="page-title pull-left">@ViewData["title"]</h3>
        <p class="pull-right">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">Create New</a>
        </p>
    </div>
</div>

<!-- Search panel -->
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">Search</h3></div>
            <div class="panel-body">
                <form method="get" class="form-inline">
                    <input class="form-control" asp-for="SearchModel.Registration" placeholder="Registration" />
                    <input class="form-control" asp-for="SearchModel.SerialNumber" placeholder="MSN" />
                    <select class="form-control" asp-for="SearchModel.AircraftModelId" asp-items="Model.Models">
                        <option value="">-- Model --</option>
                    </select>
                    <button type="submit" class="btn btn-success m-l-10">Search</button>
                    <a class="btn btn-primary m-l-10" asp-page="./Index">View All</a>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- List -->
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Aircrafts (@Model.Aircrafts.Count)</h3>
            </div>
            <div class="panel-body">
                <table id="datatable" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Registration</th>
                            <th>MSN</th>
                            <th>Model</th>
                            <th>Status</th>
                            <th>FH</th>
                            <th>Cycles</th>
                            <th>Active</th>
                            <th>Operation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Aircrafts)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Registration</td>
                                <td>@item.SerialNumber</td>
                                <td>@item.AircraftModelName</td>
                                <td>@item.Status</td>
                                <td>@item.TotalFlightHours</td>
                                <td>@item.TotalCycles</td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <i class="fa fa-check text-success"></i>
                                    }
                                    else
                                    {

                                        <i class="fa fa-remove text-danger"></i>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-warning btn-xs"
                                       href="#showmodal=@Url.Page("./Index", "Edit", new { id = item.Id })">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/AdminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/assets/datatables/dataTables.bootstrap.js"></script>
    <script>$(function () { $('#datatable').dataTable(); });</script>
}