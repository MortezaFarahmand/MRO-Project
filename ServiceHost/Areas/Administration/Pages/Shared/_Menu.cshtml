@inject _0_Framework.Application.IAuthHelper AuthHelper
@{
    var currentAccount = AuthHelper.CurrentAccountInfo();
}

<div class="left side-menu">
    <div class="sidebar-inner slimscrollleft">
        <div class="user-details">
            <div class="pull-left">
                <img src="~/Img/profilePhotos/@currentAccount.ProfilePhoto" alt="" class="thumb-md img-circle">
            </div>
            <div class="user-info">
                <div class="dropdown">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                        @currentAccount.Fullname <span class="caret"></span>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="javascript:void(0)"><i class="md md-face-unlock"></i> Profile</a></li>
                        <li><a href="javascript:void(0)"><i class="md md-settings"></i> Settings</a></li>
                        <li><a href="javascript:void(0)"><i class="md md-lock"></i> Lock screen</a></li>
                        <li><a href="javascript:void(0)"><i class="md md-settings-power"></i> Logout</a></li>
                    </ul>
                </div>
                <p class="text-muted m-0">@currentAccount.Role</p>
            </div>
        </div>

        <div id="sidebar-menu">
            <ul>
                <!-- Dashboard -->
                <li>
                    <a asp-page="/Index" class="waves-effect active">
                        <i class="md md-home"></i><span> Dashboard </span>
                    </a>
                </li>

                <!-- Accounts -->
                <li class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-account-box"></i>
                        <span>Accounts Management</span>
                        <span class="pull-right"><i class="md md-add"></i></span>
                    </a>
                    <ul class="list-unstyled">
                        <li><a asp-page="/Account/Accounts/Index">Accounts</a></li>
                        <li><a asp-page="/Account/Roles/Index">Roles</a></li>
                    </ul>
                </li>

                <!-- Part & Inventory -->
                <li class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-store"></i>
                        <span>Part & Inventory</span>
                        <span class="pull-right"><i class="md md-add"></i></span>
                    </a>
                    <ul class="list-unstyled">
                        <li><a asp-page="/Part/Parts/Index">Parts</a></li>
                        <li><a asp-page="/Part/PartAlternates/Index">Alternate Parts</a></li>

                        <li class="has_sub">
                            <a class="waves-effect">
                                <span>Inventory</span>
                                <span class="pull-right"><i class="md md-add"></i></span>
                            </a>
                            <ul class="list-unstyled">
                                <li><a asp-page="/Part/Inventory/InventoryItems/Index">Inventory Items</a></li>
                                <li><a asp-page="/Part/Inventory/StockMovements/Index">Stock Movements</a></li>
                            </ul>

                        <li class="has_sub">
                            <a class="waves-effect">
                                <span>Stock</span>
                                <span class="pull-right"><i class="md md-add"></i></span>
                            </a>
                            <ul class="list-unstyled">
                                <li><a asp-page="/Part/Stock/Stores/Index">Stores</a></li>
                                <li><a asp-page="/Part/Stock/StockTypes/Index">Stock Types (Rooms)</a></li>
                                
                            </ul>
                        </li>

                        <li class="has_sub">
                            <a class="waves-effect">
                                <span>Basic Data</span>
                                <span class="pull-right"><i class="md md-add"></i></span>
                            </a>
                            <ul class="list-unstyled">
                                <li><a asp-page="/Part/Basic_data/EquipmentTypes/Index">Equipment Types</a></li>
                            </ul>
                        </li>
                    </ul>
                </li>

                <!-- Fleet -->
                <li class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-flight"></i>
                        <span>Fleet Management</span>
                        <span class="pull-right"><i class="md md-add"></i></span>
                    </a>
                    <ul class="list-unstyled">
                        <li><a asp-page="/Fleet/Aircrafts/Index">Aircrafts</a></li>
                        <li><a asp-page="/Fleet/AircraftModels/Index">Aircraft Models</a></li>
                        <li><a asp-page="/Fleet/AircraftTypes/Index">Aircraft Types</a></li>
                    </ul>
                </li>

                <!-- Organization -->
                <li class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-domain"></i>
                        <span>Organization Settings</span>
                        <span class="pull-right"><i class="md md-add"></i></span>
                    </a>
                    <ul class="list-unstyled">
                        <li><a asp-page="/Organization/OrganizationGroups/Index">Organization Group</a></li>
                        <li><a asp-page="/Organization/Organizations/Index">Organization</a></li>
                        <li><a asp-page="/Organization/ApprovalAuthorities/Index">Approval Authority</a></li>
                        <li><a asp-page="/Organization/OrganizationPictures/Index">Organization Picture</a></li>
                        <li><a asp-page="/Organization/OrganizationAviationCodes/Index">Organization Av. Code</a></li>
                        <li><a asp-page="/Organization/OrganizationDepartments/Index">Organization Departments</a></li>
                        <li><a asp-page="/Organization/OrganizationPositions/Index">Organization Positions</a></li>
                    </ul>
                </li>

                <!-- Basic Data -->
                <li class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-settings"></i>
                        <span>BasicData Settings</span>
                        <span class="pull-right"><i class="md md-add"></i></span>
                    </a>
                    <ul class="list-unstyled">
                        <li><a asp-page="/BasicData/Entitis/Index">Entity</a></li>
                        <li><a asp-page="/BasicData/Countrys/Index">Country</a></li>
                        <li><a asp-page="/BasicData/Provinces/Index">Province</a></li>
                        <li><a asp-page="/BasicData/Cities/Index">City</a></li>
                        <li><a asp-page="/BasicData/Pictures/Index">Picture</a></li>
                        <li><a asp-page="/BasicData/PictureCategories/Index">Picture Category</a></li>
                        <li><a asp-page="/BasicData/Slidces/Index">Slider</a></li>
                        <li><a asp-page="/BasicData/Airports/Index">Airport</a></li>
                    </ul>
                </li>

                <!-- Personnel -->
                <li class="has_sub">
                    <a class="waves-effect">
                        <i class="md md-people"></i>
                        <span>Personnel Settings</span>
                        <span class="pull-right"><i class="md md-add"></i></span>
                    </a>
                    <ul class="list-unstyled">
                        <li><a asp-page="/Personnel/PersonGroups/Index">Person Group</a></li>
                        <li><a asp-page="/Personnel/Persons/Index">Person</a></li>
                        <li><a asp-page="/Personnel/PersonPictures/Index">Person Pictures</a></li>
                    </ul>
                </li>

                <!-- Logout -->
                <li class="element-dir-Fa">
                    <a asp-page="/Account" asp-page-handler="Logout" class="waves-effect">
                        <i class="fa fa-sign-out"></i><span> خروج </span>
                    </a>
                </li>
            </ul>
            <div class="clearfix"></div>
        </div>
        <div class="clearfix"></div>
    </div>
</div>