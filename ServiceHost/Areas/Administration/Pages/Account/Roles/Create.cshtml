@page
@model ServiceHost.Areas.Administration.Pages.Account.Roles.CreateModel


<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">X</button>
    <h4 class="modal-title">New Role</h4>
</div>


<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Create New Role</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <form method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Command.Name" class="control-label element-dir-Fa">نقش</label>
                                    <input type="text" class="form-control" asp-for="Command.Name">
                                    <span asp-validation-for="Command.Name" class="error"></span>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-info waves-effect waves-light">Create</button>
                        <a asp-page="./Index" class="btn btn-dark waves-effect waves-light m-b-5">بازگشت</a>
                       
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>





